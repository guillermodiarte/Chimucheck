generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  link      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  imageUrl  String?
  url       String?
  published Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String    @id @default(uuid())
  name        String
  description String?
  date        DateTime?
  location    String?
  imageUrl    String?
  url         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  active      Boolean   @default(true)
}

model SiteSection {
  id        String   @id @default(uuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model Prize {
  id          String   @id @default(uuid())
  title       String
  price       String
  description String
  images      Json
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id                 String                   @id @default(uuid())
  name               String?
  email              String                   @unique
  password           String?
  alias              String?                  @unique
  image              String?
  phone              String?
  country            String?
  province           String?
  chimucoins         Int                      @default(0)
  active             Boolean                  @default(true)
  registrationStatus String                   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  stats              PlayerStats?
  categoryStats      PlayerCategoryStats[]
  registrations      TournamentRegistration[]
  teams              Team[]
  accounts           Account[]
  raffleEntries      RaffleEntry[]
}

model Account {
  id                String  @id @default(uuid())
  playerId          String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  player            Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PlayerStats {
  id            String @id @default(uuid())
  playerId      String @unique
  wins          Int    @default(0)
  winsFirst     Int    @default(0)
  winsSecond    Int    @default(0)
  winsThird     Int    @default(0)
  matchesPlayed Int    @default(0)
  winRate       Float  @default(0.0)
  totalPrize    String @default("0")
  player        Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerCategoryStats {
  id        String   @id @default(uuid())
  playerId  String
  category  String // SHOOTER, RACING, KOMBAT, SPORTS, BOARD_GAME
  points    Int      @default(0) // 0 to 100
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, category])
}

model GlobalSettings {
  id                         String   @id @default(uuid())
  restrictPlayerRegistration Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

model Tournament {
  id             String                   @id @default(uuid())
  name           String
  description    String?
  date           DateTime
  startedAt      DateTime?
  autoStarted    Boolean                  @default(false)
  status         String                   @default("INSCRIPCION")
  maxPlayers     Int                      @default(16)
  currentPlayers Int                      @default(0)
  prizePool      String?
  image          String?
  active         Boolean                  @default(true)
  isRestricted   Boolean                  @default(false)
  category       String                   @default("SHOOTER")
  requiredRank   String                   @default("AMATEUR")
  game           String?
  format         String?
  games          String?                  @default("[]")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  photos         String?                  @default("[]")
  winners        String?                  @default("[]")
  isTeamBased    Boolean                  @default(false)
  teamSize       Int?
  registrations  TournamentRegistration[]
  gamesList      TournamentGame[]
  teams          Team[]
}

model TournamentRegistration {
  id           String     @id @default(uuid())
  playerId     String
  tournamentId String
  status       String     @default("PENDING")
  score        Int        @default(0)
  scoreHistory String     @default("[]")
  registeredAt DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String // NEW_PLAYER, TOURNAMENT_REGISTRATION
  title     String
  message   String
  read      Boolean  @default(false)
  data      String? // JSON
  createdAt DateTime @default(now())
}

model Game {
  id         String   @id @default(uuid())
  name       String   @unique
  categoryId String   // SHOOTER, RACING, KOMBAT, SPORTS, BOARD_GAME
  images     String?  @default("[]") // Para guardar JSON con las URLs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tournaments TournamentGame[]
}

model TournamentGame {
  id           String     @id @default(uuid())
  tournamentId String
  gameId       String
  format       String     @default("1vs1") // Ejemplo: 1vs1, 2vs2, etc.
  
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, gameId])
}

model Team {
  id           String     @id @default(uuid())
  name         String
  image        String?
  tournamentId String
  
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players      Player[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, name])
}

model Raffle {
  id            String        @id @default(uuid())
  title         String
  description   String?
  prize         String
  prizeImage    String?
  images        String?       @default("[]")
  type          String        @default("OPEN")     // OPEN | MANUAL
  status        String        @default("DRAFT")    // DRAFT | ACTIVE | DRAWING | FINISHED
  maxEntries    Int?
  requiresLogin Boolean       @default(true)
  drawDate      DateTime?
  winnerId      String?
  winnerAlias   String?
  winnerImage   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entries       RaffleEntry[]
  prizes        RafflePrize[]
}

model RafflePrize {
  id          String    @id @default(uuid())
  raffleId    String
  title       String
  description String?
  image       String?
  order       Int       @default(1) // 1 = 1º Puesto, 2 = 2º Puesto, 3 = 3º Puesto...
  winnerId    String?
  winnerAlias String?
  winnerImage String?
  drawnAt     DateTime?

  raffle      Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
}

model RaffleEntry {
  id        String   @id @default(uuid())
  raffleId  String
  playerId  String
  enteredAt DateTime @default(now())

  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([raffleId, playerId])
}

